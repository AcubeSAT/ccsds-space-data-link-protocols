/** Construct Virtual channel TM objects **/
    enum class VirtualChannelTmName : Defs::VcidScidKey {
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight) \
    virtualChannelName = constructVcidScidKey(vcid, parentScid),
#include "@CHANNEL_CONFIG@"
    };

#ifdef INCLUDE_SPACE_SEGMENT_CODE
    inline etl::flat_map<Defs::VcidScidKey, VirtualChannelSsTm, VirtualChannelTmCount == 0 ? 1 : VirtualChannelTmCount>  virtualChannelSsTmMap = {
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight) \
    { \
    constructVcidScidKey(vcid, parentScid), \
    VirtualChannelSsTm(         \
    vcid,                       \
    parentScid,                 \
    repetitions,                \
    secondaryHeaderPresent,     \
    secondaryHeaderLength,      \
    ocfFieldPresent,            \
    synchronization,            \
    associatedSdlsSPI,          \
    frameCapacity,              \
    packetCapacity,             \
    priorityWeight              \
    )                           \
    },
#include "@CHANNEL_CONFIG@"
    };

    inline etl::vector<Defs::VcidScidKey, VirtualChannelTmCount == 0 ? 1 : VirtualChannelTmCount> virtualChannelSsTmPrioritySortedKeys;
#endif // INCLUDE_SPACE_SEGMENT_CODE
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight)

    /** Construct Virtual channel TC Space Segment objects **/
    enum class VirtualChannelTcName : Defs::VcidScidKey {
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) \
    virtualChannelName = constructVcidScidKey(vcid, parentScid),
#include "@CHANNEL_CONFIG@"
    };

#ifdef INCLUDE_SPACE_SEGMENT_CODE
    inline etl::flat_map<Defs::VcidScidKey, VirtualChannelSsTc, VirtualChannelTcCount == 0 ? 1 : VirtualChannelTcCount> virtualChannelSsTcMap = {
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) \
    { \
    constructVcidScidKey(vcid, parentScid), \
    VirtualChannelSsTc(         \
    vcid,                       \
    parentScid,                 \
    segHeaderPresent,           \
    blocking,                   \
    copInEffect,                \
    associatedSdlsSPI,          \
    dataFieldContent,           \
    frameCapacity,              \
    typeAdPacketCapacity,       \
    typeBdPacketCapacity,       \
    priorityWeight              \
    )                           \
    },
#include "@CHANNEL_CONFIG@"
    };

    inline etl::vector<Defs::VcidScidKey, VirtualChannelTcCount == 0 ? 1 : VirtualChannelTcCount> virtualChannelSsTcPrioritySortedKeys;
#endif // INCLUDE_SPACE_SEGMENT_CODE

#ifdef INCLUDE_GROUND_SEGMENT_CODE
    inline etl::flat_map<Defs::VcidScidKey, VirtualChannelGsTc, VirtualChannelTcCount == 0 ? 1 : VirtualChannelTcCount> virtualChannelGsTcMap = {
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) \
    { \
    constructVcidScidKey(vcid, parentScid), \
    VirtualChannelGsTc(         \
    vcid,                       \
    parentScid,                 \
    repetitionsTypeAD,          \
    repetitionsTypeBC,          \
    segHeaderPresent,           \
    blocking,                   \
    copInEffect,                \
    associatedSdlsSPI,          \
    dataFieldContent,           \
    frameCapacity,              \
    typeAdPacketCapacity,       \
    typeBdPacketCapacity,       \
    priorityWeight              \
    )                           \
    },
#include "@CHANNEL_CONFIG@"
    };

    inline etl::vector<Defs::VcidScidKey, VirtualChannelTcCount == 0 ? 1 : VirtualChannelTcCount> virtualChannelGsTcPrioritySortedKeys;
#endif // INCLUDE_GROUND_SEGMENT_CODE
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

    /** Construct MAP channel objects **/
   enum class MapChannelName : Defs::MapidVcidScidKey {
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) \
    mapChannelName = constructMapidVcidScidKey(mapid, parentVcid, parentScid),
#include "@CHANNEL_CONFIG@"
    };

#ifdef INCLUDE_SPACE_SEGMENT_CODE
    inline etl::flat_map<Defs::MapidVcidScidKey, MAPChannelSs, MapChannelCount == 0 ? 1 : MapChannelCount> mapChannelSsMap = {
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) \
    { \
    constructMapidVcidScidKey(mapid, parentVcid, parentScid), \
    MAPChannelSs(         \
    mapid,                \
    parentVcid,           \
    parentScid,           \
    blocking,             \
    segmentation,         \
    associatedSdlsSPI,    \
    dataFieldContent,     \
    frameCapacity,        \
    typeAdPacketCapacity, \
    typeBdPacketCapacity, \
    priorityWeight        \
    )                     \
    },
#include "@CHANNEL_CONFIG@"
    };

    inline etl::vector<Defs::MapidVcidScidKey, MapChannelCount == 0 ? 1 : MapChannelCount> mapChannelSsPrioritySortedKeys;
#endif // INCLUDE_SPACE_SEGMENT_CODE

#ifdef INCLUDE_GROUND_SEGMENT_CODE
    inline etl::flat_map<Defs::MapidVcidScidKey, MAPChannelGs, MapChannelCount == 0 ? 1 : MapChannelCount> mapChannelGsMap = {
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) \
    { \
    constructMapidVcidScidKey(mapid, parentVcid, parentScid), \
    MAPChannelGs(                \
    mapid,                       \
    parentVcid,                  \
    parentScid,                  \
    blocking,                    \
    segmentation,                \
    associatedSdlsSPI,           \
    dataFieldContent,            \
    frameCapacity,               \
    typeAdPacketCapacity,        \
    typeBdPacketCapacity,        \
    priorityWeight               \
    )                            \
    },
#include "@CHANNEL_CONFIG@"
    };

    inline etl::vector<Defs::MapidVcidScidKey, MapChannelCount == 0 ? 1 : MapChannelCount> mapChannelGsPrioritySortedKeys;
#endif // INCLUDE_GROUND_SEGMENT_CODE
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

/** Construct FARM and FOP Objects (COP-1) **/
#ifdef INCLUDE_GROUND_SEGMENT_CODE
    inline etl::flat_map<Defs::VcidScidKey, FrameOperationProcedure, cop1Count == 0 ? 1 : cop1Count> fopMap = {
#define COP1(scid, vcid, tiInitial, transmissionLimit, fopSlidingWindowWidth, timeoutType, farmSlidingWindowWidth, clcwReportInterval) \
    {                           \
    constructVcidScidKey(vcid, scid), \
    FrameOperationProcedure(    \
    scid,                       \
    vcid,                       \
    tiInitial,                  \
    transmissionLimit,          \
    fopSlidingWindowWidth,      \
    timeoutType                 \
    )                           \
    },
#include "@CHANNEL_CONFIG@"
    };
#endif // INCLUDE_GROUND_SEGMENT_CODE

#ifdef INCLUDE_SPACE_SEGMENT_CODE
    inline etl::flat_map<Defs::VcidScidKey, FrameAcceptanceReporting, cop1Count == 0 ? 1 : cop1Count> farmMap = {
#define COP1(scid, vcid, tiInitial, transmissionLimit, fopSlidingWindowWidth, timeoutType, farmSlidingWindowWidth, clcwReportInterval) \
    {                           \
    constructVcidScidKey(vcid, scid), \
    FrameAcceptanceReporting(   \
    vcid,                       \
    farmSlidingWindowWidth,     \
    clcwReportInterval,         \
    transmissionLimit           \
    )                           \
    },
#include "@CHANNEL_CONFIG@"
    };
#endif // INCLUDE_SPACE_SEGMENT_CODE
#define COP1(scid, vcid, tiInitial, transmissionLimit, fopSlidingWindowWidth, timeoutType, farmSlidingWindowWidth, clcwReportInterval)

/** Construct Security Association Objects **/
#define SECURITY_ASSOCIATION(spi, authenticationAlgorithm, encryptionAlgorithm) \
    {                           \
    spi,                        \
    SecurityAssociation(        \
    spi,                        \
    authenticationAlgorithm,    \
    encryptionAlgorithm         \
    )                           \
    },

// The sender and receiver use the same object, but due to some shared variables, separate
// instances are required
#ifdef INCLUDE_SPACE_SEGMENT_CODE
    inline etl::flat_map<uint16_t, SecurityAssociation, saCount == 0 ? 1 : saCount> saSpaceSegmentMap = {
#include "@CHANNEL_CONFIG@"
    };
#endif// INCLUDE_SPACE_SEGMENT_CODE

#ifdef INCLUDE_GROUND_SEGMENT_CODE
    inline etl::flat_map<uint16_t, SecurityAssociation, saCount == 0 ? 1 : saCount> saGroundSegmentMap = {
#include "@CHANNEL_CONFIG@"
    };
#endif // INCLUDE_GROUND_SEGMENT_CODE
#define SECURITY_ASSOCIATION(spi, authenticationAlgorithm, encryptionAlgorithm)

/** Memory allocation for containers and Memory pool creation for frame octets  **/
#ifdef INCLUDE_GROUND_SEGMENT_CODE
    inline constexpr bool IncludeSpaceCode = true;
#else
    inline constexpr bool IncludeSpaceCode = false;
#endif

#ifdef INCLUDE_GROUND_SEGMENT_CODE
    inline constexpr bool IncludeGroundCode = true;
#else
    inline constexpr bool IncludeGroundCode = false;
#endif

// Calculate total frame capacity for virtual and map channels
    inline constexpr uint16_t TotalVirtualChannelTcFrameCapacity = (0
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) +frameCapacity
#include "@CHANNEL_CONFIG@"
);
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

    inline constexpr uint16_t TotalVirtualChannelTmFrameCapacity = (0
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight) +frameCapacity
#include "@CHANNEL_CONFIG@"
);
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight)

    inline constexpr uint16_t TotalMapChannelFrameCapacity = (0
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) +frameCapacity
#include "@CHANNEL_CONFIG@"
);
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

// Calculate total packet capacity for TM channels:
    inline constexpr uint16_t TotalTmPacketCapacity = (0
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight) +packetCapacity
#include "@CHANNEL_CONFIG@"
    );
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight)

// Calculate total ocf sdu capacity needed for master channels
    inline constexpr uint16_t TotalOcfSduCapacity = (0
#define MASTER_CHANNEL_TM(masterChannelName, scid, parentPcid, ocfSduCapacity) + ocfSduCapacity
    #include "@CHANNEL_CONFIG@"
        );
#define MASTER_CHANNEL_TM(masterChannelName, scid, parentPcid, ocfSduCapacity)

// Calculate total packet capacity for TC channels:
    inline constexpr uint16_t TotalMapChannelTypeAdPacketCapacity = (0
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) +typeAdPacketCapacity
#include "@CHANNEL_CONFIG@"
);
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

    inline constexpr uint16_t TotalVirtualChannelTypeAdCapacity = (0
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) +typeAdPacketCapacity
#include "@CHANNEL_CONFIG@"
    );
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

    inline constexpr uint16_t TotalMapChannelTypeBdPacketCapacity = (0
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) +typeBdPacketCapacity
#include "@CHANNEL_CONFIG@"
);
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

    inline constexpr uint16_t TotalVirtualChannelTypeBdCapacity = (0
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) +typeBdPacketCapacity
#include "@CHANNEL_CONFIG@"
    );
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

// Calculate total capacity for secondary header octets (sum of queue capacity * {length of secondary header-1}, for all ss tm channels)
    inline constexpr uint16_t TotalSecondaryHeaderOctetCapacity = (0
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight) + (secondaryHeaderLength - Defs::TmSecondaryHeaderIdLength)
#include "@CHANNEL_CONFIG@"
    ) * Defs::SecondaryHeaderFieldCapacity * IncludeSpaceCode;
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight)

#undef PHYSICAL_CHANNEL
#undef MASTER_CHANNEL_TM
#undef MASTER_CHANNEL_TC
#undef VIRTUAL_CHANNEL_TM
#undef VIRTUAL_CHANNEL_TC
#undef MAP_CHANNEL
#undef COP1
#undef SECURITY_ASSOCIATION

    // Calculate amount of slots each type of data structure needed
    // Note1: The required capacity for a master channel is the sum of the capacities of its virtual channels
    // Note2: For a TC virtual channel that has map channels, it's frame capacity was defined as 0 in the .def file,
    //       since the actual capacity is the sum of said map channels. Therefore, the TotalVirtualChannelFrameCapacity
    //       variable actually contains capacities of virtual channels that DO NOT contain map channels. The total capacity
    //       required for virtual channel WITH map channels is the TotalMapChannelFrameCapacity

    inline constexpr uint16_t TotalTransferFrameTcSlots = (IncludeGroundCode + IncludeSpaceCode) *
        (TotalMapChannelFrameCapacity + TotalVirtualChannelTcFrameCapacity);

    // MapChannelSs: 2 queues -> 2 * TotalMapChannelFrameCapacity
    // VirtualChannelSsTc: 5 queues ->  5 * (TotalMapChannelFrameCapacity + TotalVirtualChannelTcFrameCapacity)
    // MasterChannelSsTc: No queues
    // MapChannelGsTc: No queues
    // VirtualChannelGsTc: 2 queues -> 2 * (TotalMapChannelFrameCapacity + TotalVirtualChannelTcFrameCapacity)
    // MasterChannelGsTc: 1 queue -> TotalMapChannelFrameCapacity + TotalVirtualChannelTcFrameCapacity
    inline constexpr uint16_t TotalTransferFrameTcPtrSlots =
        IncludeSpaceCode * (
            5 * (TotalMapChannelFrameCapacity + TotalVirtualChannelTcFrameCapacity) +
            2 * TotalMapChannelFrameCapacity
        ) +
        IncludeGroundCode * (
            3 * (TotalMapChannelFrameCapacity + TotalVirtualChannelTcFrameCapacity)
        );

    inline constexpr uint16_t TotalTransferFrameTmSlots = IncludeSpaceCode *
        TotalVirtualChannelTmFrameCapacity;

    // VirtualChannelSsTm: 2 queues
    // MasterChannelSsTm: 2 queues, 1 circular buffer
    // VirtualChannelGsTm: Unimplemented
    // MasterChannelGsTm: Unimplemented
    inline constexpr uint16_t TotalTransferFrameTmPtrSlots = IncludeSpaceCode *
        5 * TotalVirtualChannelTmFrameCapacity;

    inline constexpr uint16_t TotalTypeAdPacketSlots = IncludeGroundCode * (TotalVirtualChannelTypeAdCapacity + TotalMapChannelTypeAdPacketCapacity);
    inline constexpr uint16_t TotalTypeBdPacketSlots = IncludeGroundCode * (TotalVirtualChannelTypeBdCapacity + TotalMapChannelTypeBdPacketCapacity);
    inline constexpr uint16_t TotalTmPacketSlots = TotalTmPacketCapacity; // We add the secondary header octets here as well

    inline TransferFrameTC transferFrameTcArray[TotalTransferFrameTcSlots];
    inline TransferFrameTC* transferFrameTcPtrArray[TotalTransferFrameTcPtrSlots];
    inline TransferFrameTM transferFrameTmArray[TotalTransferFrameTmSlots];
    inline TransferFrameTM* transferFrameTmPtrArray[TotalTransferFrameTmPtrSlots];
    inline uint16_t packetLengthsArray[TotalTypeAdPacketSlots + TotalTypeBdPacketSlots + TotalTmPacketSlots];
    inline uint8_t packetOctetsArray[(TotalTypeAdPacketSlots + TotalTypeBdPacketSlots + TotalTmPacketSlots) * Defs::MaxExpectedSpacePacketSize + TotalSecondaryHeaderOctetCapacity]; // also holds the memory of secondary header octets
    inline uint32_t indicesArray[TotalTransferFrameTcSlots + TotalTransferFrameTmSlots
        + TotalOcfSduCapacity]; // also holds the memory of the ocfSdu queue in masterChannelSsTm

    inline MemoryPool<TotalTransferFrameTcSlots * Defs::MaxTcTransferFrameLength + TotalTransferFrameTmSlots * Defs::MaxTmTransferFrameLength,
    TotalTransferFrameTcSlots + TotalTransferFrameTmSlots> frameOctetPool;
} // namespace CCSDSDataLinkLayer::Generated