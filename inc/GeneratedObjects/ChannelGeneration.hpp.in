/**
 * @file ChannelGeneration.hpp
 *
 * @brief Generate CCSDS channel objects at compile time using the configuration in CCSDSDataLink.def
 */

#pragma once
// This is added to suppress multiple redefinition warnings
#if defined(__clang__)
  #pragma clang system_header
#elif defined(__GNUC__)
  #pragma GCC system_header
#endif

#include "etl/flat_map.h"
#include "etl/vector.h"
#include "CcsdsDefinitions.hpp"
#include "FrameAcceptanceReporting.hpp"
#include "FrameOperationProcedure.hpp"
#include "SecurityAssociation.hpp"
#include "PhysicalChannel.hpp"
#include "MasterChannel.hpp"
#include "VirtualChannel.hpp"
#include "MapChannel.hpp"
#include "TransferFrameTC.hpp"
#include "TransferFrameTM.hpp"
#include "MemoryPool.hpp"
#include "AddressingAndParsingUtilities.hpp"

namespace CCSDSDataLinkLayer::Generated {
// Initially define all macros as empty. Then selectively define some them to create different objects statically
#define PHYSICAL_CHANNEL(physicalChannelName, pcid, tfvn, maxTcLength, tmLength, maxFramesPdu, maxPduLength, maximumBitRate, fecPresent)
#define MASTER_CHANNEL_TM(masterChannelName, scid, parentPcid, ocfSduCapacity)
#define MASTER_CHANNEL_TC(masterChannelName, scid, parentPcid)
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight)
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)
#define COP1(scid, vcid, tiInitial, transmissionLimit, fopSlidingWindowWidth, timeoutType, farmSlidingWindowWidth, clcwReportInterval)
#define SECURITY_ASSOCIATION(spi, authenticationAlgorithm, encryptionAlgorithm)

/** Calculate channel counts
 *  Note: Each "channel" is constituted of a space and ground segment, except the physical channel.
 *        Therefore, 3 TC virtual channels actually result in the construction of 6 virtual channel objects (assuming
 *        both space and ground segment code are compiled)
 */

    inline constexpr uint8_t PhysicalChannelCount = (0
#define PHYSICAL_CHANNEL(physicalChannelName, pcid, tfvn, maxTcLength, tmLength, maxFramesPdu, maxPduLength, maximumBitRate, fecPresent) +1
#include "@CHANNEL_CONFIG@"
    );
#define PHYSICAL_CHANNEL(physicalChannelName, pcid, tfvn, maxTcLength, tmLength, maxFramesPdu, maxPduLength, maximumBitRate, fecPresent)

    inline constexpr uint8_t MasterChannelTmCount = (0
#define MASTER_CHANNEL_TM(masterChannelName, scid, parentPcid, ocfSduCapacity) +1
#include "@CHANNEL_CONFIG@"
    );
#define MASTER_CHANNEL_TM(masterChannelName, scid, parentPcid, ocfSduCapacity)

    inline constexpr uint8_t MasterChannelTcCount = (0
#define MASTER_CHANNEL_TC(masterChannelName, scid, parentPcid) +1
#include "@CHANNEL_CONFIG@"
    );
#define MASTER_CHANNEL_TC(masterChannelName, scid, parentPcid)

    inline constexpr uint8_t VirtualChannelTmCount = (0
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight) +1
#include "@CHANNEL_CONFIG@"
    );
#define VIRTUAL_CHANNEL_TM(virtualChannelName, vcid, parentScid, associatedSdlsSPI, secondaryHeaderPresent, secondaryHeaderLength, ocfFieldPresent, synchronization, repetitions, frameCapacity, packetCapacity, priorityWeight)

    inline constexpr uint8_t VirtualChannelTcCount = (0
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) +1
#include "@CHANNEL_CONFIG@"
    );
#define VIRTUAL_CHANNEL_TC(virtualChannelName, vcid, parentScid, segHeaderPresent, blocking, copInEffect, associatedSdlsSPI, repetitionsTypeAD, repetitionsTypeBC, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

    inline constexpr uint8_t MapChannelCount = (0
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight) +1
#include "@CHANNEL_CONFIG@"
    );
#define MAP_CHANNEL(mapChannelName, mapid, parentVcid, parentScid, blocking, segmentation, associatedSdlsSPI, dataFieldContent, frameCapacity, typeAdPacketCapacity, typeBdPacketCapacity, priorityWeight)

    inline constexpr uint8_t cop1Count = (0
#define COP1(scid, vcid, tiInitial, transmissionLimit, fopSlidingWindowWidth, timeoutType, farmSlidingWindowWidth, clcwReportInterval) +1
#include "@CHANNEL_CONFIG@"
    );
#define COP1(scid, vcid, tiInitial, transmissionLimit, fopSlidingWindowWidth, timeoutType, farmSlidingWindowWidth, clcwReportInterval)

    inline constexpr uint8_t saCount = (0
#define SECURITY_ASSOCIATION(spi, authenticationAlgorithm, encryptionAlgorithm) +1
#include "@CHANNEL_CONFIG@"
    );
#define SECURITY_ASSOCIATION(spi, authenticationAlgorithm, encryptionAlgorithm)

/** Construct Physical channel objects **/
    enum class PhysicalChannelName : Defs::Pcid {
#define PHYSICAL_CHANNEL(physicalChannelName, pcid, tfvn, maxTcLength, tmLength, maxFramesPdu, maxPduLength, maximumBitRate, fecPresent) physicalChannelName = static_cast<Defs::Pcid>(pcid),
#include "@CHANNEL_CONFIG@"
    };

    inline etl::flat_map<Defs::Pcid, PhysicalChannel, (PhysicalChannelCount == 0) ? 1 : PhysicalChannelCount> physicalChannelMap = {
#define PHYSICAL_CHANNEL(physicalChannelName, pcid, tfvn, maxTcLength, tmLength, maxFramesPdu, maxPduLength, maximumBitRate, fecPresent) \
    {                               \
    static_cast<Defs::Pcid>(pcid),  \
    PhysicalChannel(                \
    static_cast<Defs::Pcid>(pcid),  \
    tfvn,                           \
    maxTcLength,                    \
    tmLength,                       \
    maxFramesPdu,                   \
    maxPduLength,                   \
    maximumBitRate,                 \
    fecPresent                      \
    )                               \
    },
#include "@CHANNEL_CONFIG@"
    };
#define PHYSICAL_CHANNEL(physicalChannelName, pcid, tfvn, maxTcLength, tmLength, maxFramesPdu, maxPduLength, maximumBitRate, fecPresent)

/** Construct Master channel TM objects **/
    enum class MasterChannelTmName : Defs::Scid {
#define MASTER_CHANNEL_TM(masterChannelName, scid, parentPcid, ocfSduCapacity) masterChannelName = static_cast<Defs::Scid>(scid),
#include "@CHANNEL_CONFIG@"
    };

#ifdef INCLUDE_SPACE_SEGMENT_CODE
    inline etl::flat_map<Defs::Scid, MasterChannelSsTm, MasterChannelTmCount == 0 ? 1 : MasterChannelTmCount> masterChannelSsTmMap = {
#define MASTER_CHANNEL_TM(masterChannelName, scid, parentPcid, ocfSduCapacity) \
    {                                     \
    static_cast<Defs::Scid>(scid),        \
    MasterChannelSsTm(                    \
    static_cast<Defs::Scid>(scid),        \
    static_cast<Defs::Pcid>(parentPcid),  \
    ocfSduCapacity                        \
    )                                     \
    },
#include "@CHANNEL_CONFIG@"
    };
#endif // INCLUDE_SPACE_SEGMENT_CODE
#define MASTER_CHANNEL_TM(masterChannelName, scid, parentPcid, ocfSduCapacity)

 /** Construct Master channel TC objects **/
    enum class MasterChannelTcName : Defs::Scid {
#define MASTER_CHANNEL_TC(masterChannelName, scid, parentPcid) masterChannelName = static_cast<Defs::Scid>(scid),
#include "@CHANNEL_CONFIG@"
    };

#ifdef INCLUDE_SPACE_SEGMENT_CODE
    inline etl::flat_map<Defs::Scid, MasterChannelSsTc, MasterChannelTcCount == 0 ? 1 : MasterChannelTcCount> masterChannelSsTcMap = {
#define MASTER_CHANNEL_TC(masterChannelName, scid, parentPcid) \
    {                                    \
    static_cast<Defs::Scid>(scid),       \
    MasterChannelSsTc(                   \
    static_cast<Defs::Scid>(scid),       \
    static_cast<Defs::Pcid>(parentPcid)  \
    )                                    \
    },
#include "@CHANNEL_CONFIG@"
    };
#endif // INCLUDE_SPACE_SEGMENT_CODE

#ifdef INCLUDE_GROUND_SEGMENT_CODE
    inline etl::flat_map<Defs::Scid, MasterChannelGsTc, MasterChannelTcCount == 0 ? 1 : MasterChannelTcCount> masterChannelGsTcMap = {
#define MASTER_CHANNEL_TC(masterChannelName, scid, parentPcid) \
    {                                    \
    static_cast<Defs::Scid>(scid),       \
    MasterChannelGsTc(                   \
    static_cast<Defs::Scid>(scid),       \
    static_cast<Defs::Pcid>(parentPcid)  \
    )                                    \
    },
#include "@CHANNEL_CONFIG@"
    };
#endif // INCLUDE_GROUND_SEGMENT_CODE
