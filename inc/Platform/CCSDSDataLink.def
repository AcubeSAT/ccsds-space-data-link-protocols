// =====================================================================================================================
// Introduction
//
// Create your data link configuration in a static manner here, using macros.
// This implementation allows the configuration of 8 data link objects:
//
// - PHYSICAL_CHANNEL: Stores core data link parameters
// - MASTER_CHANNEL_TM: Main telemetry channel
// - MASTER_CHANNEL_TC: Main telecommand channel
// - VIRTUAL_CHANNEL_TM: Granularizes telemetry traffic of MASTER_CHANNEL_TM to multiple streams
// - VIRTUAL_CHANNEL_TC: Granularizes telecommand traffic of MASTER_CHANNEL_TC to multiple streams
// - MAP_CHANNEL: Granularizes telecommand traffic of a single VIRTUAL_CHANNEL_TC to multiple streams
// - COP1: A closed loop procedure that manages telecommand acknowledgement
// - SECURITY_ASSOCIATION: Offers frame authentication services to traffic in VIRTUAL_CHANNEL_TC and MAP_CHANNEL.
//
// =====================================================================================================================
// General rules:
//
// - Define one PHYSICAL_CHANNEL() per link
// - Define one MASTER_CHANNEL_TM() per PHYSICAL_CHANNEL()
// - Define at least one VIRTUAL_CHANNEL_TM() per MASTER_CHANNEL_TM()
// - Define at least one VIRTUAL_CHANNEL_TC() per MASTER_CHANNEL_TC()
// - Definition of MAP_CHANNEL() is optional. Note however, that if a VIRTUAL_CHANNEL_TC()
//   has at least one MAP_CHANNEL(), then frames cannot be inserted directly to the VIRTUAL_CHANNEL_TC()
//   itself, but rather on one of it's MAP_CHANNELS
// - TM channels should be associated with TM channels only. Same for TC.
// - Channels that have the same id and name, but different types of frames (TM/TC) are allowed
// - If there exists at least one defined TC channel with enabled COP, it is necessary that at least
//   for a return path to exist, for generated acknowledgements. A TM virtual channel with an operational
//   control field enabled can fill that purpose.
//
// =====================================================================================================================
//
// - PHYSICAL_CHANNEL(physicalChannelName,
//                    pcid,
//                    tfvn,
//                    maxTcLength,
//                    tmLength,
//                    maxFramesPdu,
//                    maxPduLength,
//                    maximumBitRate,
//                    fecPresent)
//   -- physicalChannelName: A name that can be used to uniquely identify this physical channel.
//   -- pcid: An 8 bit id to uniquely identify this physical channel. It is not part of the CCSDS standards, and is not
//            carried by any frame. It is added for addressing consistency with the other channels.
//   -- tfvn: Transfer frame version number. Enter the value:
//            "Defs::TransferFrameVersionNumber::TM_TC_SYNCHRONOUS_TRANSFER_FRAME_V1".
//   -- maxTcLength: The maximum allowed length of a TC frame (in bytes). Do not insert more than
//                   "MaxTcTransferFrameLength" (Defined in DefinitionsAndUtilities.hpp).
//   -- tmLength: The length of the TM frame in bytes. Do not insert more than "MaxTmTransferFrameLength".
//   -- maxFramesPdu: Unimplemented. This value will be ignored.
//   -- maxPduLength: Unimplemented. This value will be ignored.
//   -- maximumBitRate: Unimplemented. This value will be ignored.
//   -- fecPresent: A non zero number indicates that frames on this physical channel will have a frame error control
//                  field (16 bit CRC code).
//
// =====================================================================================================================
//
// - MASTER_CHANNEL_TM(masterChannelName,
//                     scid,
//                     parentPcid,
//                     ocfSduCapacity)
//   -- masterChannelName: A name that can be used to uniquely identify this master channel.
//   -- scid: A 10 bit id assigned by CCSDS, for uniquely defining a master channel.
//   -- parentPcid: Associates this master channel with a specific physical channel.
//   -- ocfSduCapacity: If the ocf service is used in a virtual channel under this master channel, a queue is required
//                      to hold the OCF_SDUs waiting to be transmitted. This parameter controls the size of that queue.
//                      Insert 0 if the ocf service is not used in any virtual channel.
//
// =====================================================================================================================
//
// - MASTER_CHANNEL_TC(masterChannelName,
//                     scid,
//                     parentPcid)
//   -- masterChannelName: A name that can be used to uniquely identify this master channel.
//   -- scid: A 10 bit id assigned by CCSDS, for uniquely defining a master channel.
//   -- parentPcid: Associates this master channel with a specific physical channel.
//
// =====================================================================================================================
//
// - VIRTUAL_CHANNEL_TM(virtualChannelName,
//                      vcid,
//                      parentScid,
//                      associatedSdlsSPI,
//                      secondaryHeaderPresent,
//                      secondaryHeaderLength,
//                      ocfFieldPresent,
//                      synchronization,
//                      repetitions,
//                      frameCapacity,
//                      packetCapacity,
//                      priorityWeight)
//   -- virtualChannelName: A name that can be used to uniquely identify this virtual channel
//   -- vcid: A 3 bit id (unique for all TM virtual channels under a specific TM master channel)
//   -- parentScid: Associates this virtual channel with a specific master channel
//   -- associatedSdls: Security parameter index associated with this virtual channel. Unimplemented for TM frames
//                      (unimplemented, this value is ignored)
//   -- secondaryHeaderPresent: Whether a secondary header will be present in frames of this virtual channel. Secondary
//                              headers are mission specified and can have a custom length. Note however that all frames
//                              of this virtual channel need to have a secondary header, therefore to avoid channel
//                              congestion, a sufficient secondary header data field rate will be required.
//   -- secondaryHeaderLength: The length of the entire secondary header. Note every secondary header has a mandatory
//                             one byte ID, so the length that needs to be inserted is:
//                             mission specified data field length + 1
//                             **WARNING**: If secondaryHeaderPresent is false, this value MUST be set to 0.
//                             Otherwise, an excess amount of memory will be allocated.
//   -- ocfFieldPresent: Whether the frame has an operational control field. This field can be used to transfer CLCWs
//                       generated by the COP1 procedures.
//   -- synchronization: Use "Defs::SynchronizationFlag::OCTET_SYNCHRONIZED_FORWARD_ORDERED" if the frame payload has a known
//                       structure (this version of the protocol supports "Space Packets" and "Encapsulation Packets").
//                       If it has a different structure, enter "Defs::SynchronizationFlag::VCA_SDU". Note that VCA_SDUs need
//                       to be of fixed length (equal to the transfer frame data field length).
//   -- repetitions: How many times each frame will be transmitted to the Channel Coding and Synchronization Sublayer.
//   -- frameCapacity: Maximum amount of frames this channel can support (affects memory allocation size).
//   -- packetCapacity: Maximum amount of packets this channel can support (affects memory allocation size). A packet
//                      is defined as the data unit carried by the data field of a frame.
//   -- priorityWeight: A non negative integer that indicates the importance of the data in this channel. A higher
//                      weight means that the channel frames are passed to the respective master channel first (weighted
//                      priority scheduling). To avoid starvation issues, ensure that channels with higher weights have
//                      smaller data rates, relative to lower weight channels.
//
// =====================================================================================================================
//
// - VIRTUAL_CHANNEL_TC(virtualChannelName,
//                      vcid,
//                      parentScid,
//                      segHeaderPresent,
//                      blocking,
//                      copInEffect,
//                      associatedSdlsSPI,
//                      repetitionsTypeAD,
//                      repetitionsTypeBC,
//                      dataFieldContent,
//                      frameCapacity,
//                      typeAdPacketCapacity,
//                      typeBdPacketCapacity
//                      priorityWeight)
//   -- virtualChannelName: A name that can be used to uniquely identify this virtual channel.
//   -- vcid: A 6 bit id (unique for all TM virtual channels under a specific TM master channel).
//   -- parentScid: Associates this virtual channel with a specific master channel.
//   -- segHeaderPresent: A value of non zero indicates that map channels exist under this virtual channel. Note that
//                        with this setting it is not possible to insert packets directly in the virtual channel, but
//                        has to be done via the MAP channels instead.
//   -- blocking: A value of non zero allows combining multiple small packets in a single TC transfer frame. Superseded
//                in the scenario that map channels exist under this virtual channel. Ineffective if VCA_SDUs are used
//                (look dataFieldContent), as blocking and segmentation is not supported.
//   -- copInEffect: A value of non zero indicates that COP-1 frame acknowledgement system is active for this channel.
//                   For COP-1 to work, ensure that a single COP1() object is associated with this channel.
//   -- associatedSdlsSPI: Security parameter index associated with this virtual channel. Value 0 indicates that frames
//                         in this channel are not encrypted, nor authenticated. Superseded in the scenario that map
//                         channels exist under this virtual channel. Ensure that a SECURITY_ASSOCIATION() with this
//                         associatedSdls exists.
//   -- repetitionsTypeAD: How many times Type-AD frames will be transmitted to the Channel Coding and Synchronization
//                         Sublayer. Note that if cop is not active in this virtual channel, duplicate frames cannot
//                         be detected on the receiver side, due to the fact that the frame sequence number is unused.
//                         A higher level protocol must discard duplicate TCs
//   -- repetitionsTypeBC: How many times Type-BC frames will be transmitted to the Channel Coding and Synchronization
//                         Sublayer. Type-BC frames carry special commands, generated by the COP-1 management service.
//                         This value will be ignored if cop is not active in this virtual channel.
//   -- dataFieldContent: Use "Defs::DataFieldContent::PACKET" if the frame payload has a known structure (this version of the
//                        protocol supports "Space Packets" and "Encapsulation Packets"). If it has a different
//                        structure, enter "Defs::DataFieldContent::VCA_SDU". VCA_SDUs can have variable length, but need to
//                        be contained within the maximum frame data field length. This value is superseded if MAP
//                        channels exist under this virtual channel.
//   -- frameCapacity: Maximum amount of frames this channel can support (affects memory allocation size).
//   -- typeAdPacketCapacity, typeBdPacketCapacity: Amount of packets this channel can support (affects memory
//                     allocation size). Type AD packets are subject to the COP-1 process, while Type BD are expedited
//                     (an internet protocol analogy is TCP segments vs UDP datagrams). In the scenario that COP-11 is
//                     not active for this virtual channel, TYPE-AD frames are not subject to checks, but compared to
//                     TYPE-BD, they can be transmitted multiple times (depending on the repetitionsTypeAD parameter).
//                     **WARNING**: If map channels exist under this virtual channel those values MUST be set to 0.
//                                  Otherwise, an excess amount of memory will be allocated.
//   -- priorityWeight: A non negative integer that indicates the importance of the data in this channel. A higher
//                      weight means that the channel frames are passed to the respective master channel first (weighted
//                      priority scheduling). To avoid starvation issues, ensure that channels with higher weights have
//                      smaller data rates, relative to lower weight channels.
//
// =====================================================================================================================
//
// - MAP_CHANNEL(mapChannelName,
//               mapid,
//               parentVcid,
//               parentScid,
//               blocking,
//               segmentation,
//               associatedSdlsSPI,
//               dataFieldContent,
//               frameCapacity
//               typeAdPacketCapacity,
//               typeBdPacketCapacity,
//               priorityWeight)
//   -- mapChannelName: A name that can be used to uniquely identify this map channel.
//   -- mapid: A 6 bit id (unique for all map channels under a specific TC virtual channel).
//   -- parentVcid: Associates this map with a specific virtual channel.
//   -- parentScid: This id is necessary to uniquely identify 2 map channels that have the same parentVcid, meaning
//                  their parent virtual channels belong to different master channels.
//   -- blocking: A value of non zero allows combining multiple small packets in a single TC transfer frame. Ineffective
//                if VCA_SDUs are used, as blocking and segmentation is not supported.
//   -- segmentation: A value of non zero allows splitting large packets to multiple TC transfer frames. Ineffective
//                    if VCA_SDUs are used, as blocking and segmentation is not supported.
//   -- associatedSdlsSPI: Security parameter index associated with this map channel. A value of 0 indicates that frames
//                         in this channel are not encrypted, nor authenticated.
//   -- dataFieldContent: Use "Defs::DataFieldContent::PACKET" if the frame payload has a known structure (this version of the
//                        protocol supports "Space Packets" and "Encapsulation Packets"). If it has a different
//                        structure, enter "Defs::DataFieldContent::VCA_SDU". VCA_SDUs can have variable length, but need to
//                        be contained within the maximum frame data field length.
//   -- frameCapacity: Maximum amount of frames this channel can support (affects memory allocation size).
//   -- typeAdPacketCapacity, typeBdPacketCapacity: Amount of packets this channel can support (affects memory
//                     allocation size). Type AD packets are subject to the COP-1 process, while Type BD are expedited
//                     (an internet protocol analogy is TCP segments vs UDP datagrams). In the scenario that COP-11 is
//                     not active for this virtual channel, TYPE-AD frames are not subject to checks, but compared to
//                     TYPE-BD, they can be transmitted multiple times (depending on the repetitionsTypeAD parameter).
//   -- priorityWeight: A non negative integer that indicates the importance of the data in this channel. A higher
//                      weight means that the channel frames are passed to the respective master channel first (weighted
//                      priority scheduling). To avoid starvation issues, ensure that channels with higher weights have
//                      smaller data rates, relative to lower weight channels.
//
// =====================================================================================================================
//
// - COP1(scid,
//        vcid,
//        tiInitial,
//        transmissionLimit,
//        fopSlidingWindowWidth,
//        timeoutType,
//        farmSlidingWindowWidth,
//        clcwReportInterval)
//   -- scid: A 10 bit id, that associates this COP1 objects with a specific master channel.
//   -- vcid: A 6 bit that associates this COP1 object with a specific virtual channel.
//   -- tiInitial: A reverse countdown timer initial value, in milliseconds. The ground segment will wait for this
//                 amount of time before retransmitting a TC frame.
//   -- transmissionLimit: Amount of retransmissions of a frame that will be attempted, before COP-1 concludes that
//                         there is a break in the link and raise an alert. Note that the actual amount of times a frame
//                         will be physically transmitted is repetitionsTypeAD * transmissionLimit, for TYPE-AD, and
//                         repetitionsTypeBC * transmissionLimit for TYPE-BC.
//   -- fopSlidingWindowWidth: Limits the amount of TC frames the ground segment can transmit ahead of the last
//                             acknowledged frame.
//   -- timeoutType: Defines the behavior of FOP-1 when the countdown timer expires and the maximum number of
//                   retransmissions has been reached.
//      "Defs::TimeoutType::ALERT" triggers an 'Alert' notification, indicating an unrecoverable condition and the
//       termination of the Sequence-Controlled Service guarantee.
//      "Defs::TimeoutType:: SUSPEND" suspends FOP-1 operation, allowing it to resume later when conditions permit
//       (e.g., upon receiving a CLCW).
//
//       The SUSPEND option is recommended for:
//       a) High-error-rate links: Prevents premature termination during transient issues.
//       b) Deep-space links: Accommodates high latency by allowing a 'send and suspend' approach.
//
//   -- farmSlidingWindowWidth: Determines the amount of frames that the space segment can accept before entering
//                              "lockout mode". The behavior is different depending on the value of the transmission
//                              limit. It's functionality is better understood by reading p. 6.1.8 of COP-1 CCSDS
//   -- clcwReportInterval: CLCW generation period by the space segment (in milliseconds). CLCWs can be carried by TM
//                          frames and are used by the ground segment to assess the status of accepted TCs.
//
// =====================================================================================================================
//
// - SECURITY_ASSOCIATION(spi,
//                        authenticationAlgorithm,
//                        encryptionAlgorithm)
//   -- spi: Security parameter index. Virtual and MAP channels can be associated with this security association, by
//           using this index.
//   -- authenticationAlgorithm: Currently, only "Defs::AuthenticationAlgorithm::HMAC_SHA256_40_BIT" is supported. If no
//                               authentication is required, use "Defs::AuthenticationAlgorithm::NO_AUTHENTICATION".
//   -- encryptionAlgorithm: No encryption algorithms are implemented. Enter "Defs::EncryptionAlgorithm::NO_ENCRYPTION"
//
// =====================================================================================================================

PHYSICAL_CHANNEL(TEST_PHY, 0, Defs::TransferFrameVersionNumber::TM_TC_SYNCHRONOUS_TRANSFER_FRAME_V1, 30, 30, 0, 0, 0, true)
    MASTER_CHANNEL_TM(MC, 456, 0, 10)
        VIRTUAL_CHANNEL_TM(PACKETS_AND_OCF, 0, 456, 0, false, 0, true, Defs::SynchronizationFlag::OCTET_SYNCHRONIZED_FORWARD_ORDERED, 2, 4, 4, 1)
        VIRTUAL_CHANNEL_TM(PACKETS_AND_SEC_HEADER, 1, 456, 0, false, 0, false, Defs::SynchronizationFlag::OCTET_SYNCHRONIZED_FORWARD_ORDERED, 2, 4, 4, 2)
        VIRTUAL_CHANNEL_TM(VCA_SDU_AND_OCF_AND_SEC_HEADER_AND_SA, 2, 456, 1, true, 10, true, Defs::SynchronizationFlag::VCA_SDU, 2, 4, 4, 3)
    MASTER_CHANNEL_TC(TEST_MC, 456, 0)
        VIRTUAL_CHANNEL_TC(VCA_SDU_AND_SA, 0, 456, false, false, false, 1, 2, 2, Defs::DataFieldContent::VCA_SDU, 4, 4, 4, 1)
        VIRTUAL_CHANNEL_TC(PACKETS_AND_SA_AND_BLOCKING, 1, 456, false, true, false, 1, 2, 2, Defs::DataFieldContent::PACKET, 4, 4, 4, 2)
        VIRTUAL_CHANNEL_TC(PACKETS_AND_MAP_CHANS_AND_SA, 2, 456, true, false, false, 1, 2, 2, Defs::DataFieldContent::PACKET, 4, 4, 4, 3)
            MAP_CHANNEL(BLOCKING, 0, 2, 456, true, false, 1, Defs::DataFieldContent::PACKET, 4, 4, 4, 1)
            MAP_CHANNEL(SEGMENTATION, 1, 2, 456, false, true, 1, Defs::DataFieldContent::PACKET, 4, 4, 4, 1)
            MAP_CHANNEL(BLOCKING_AND_SEGMENTATION, 2, 2, 456, true, true, 1, Defs::DataFieldContent::PACKET, 4, 4, 4, 1)
        VIRTUAL_CHANNEL_TC(PACKETS_AND_COP, 3, 456, false, false, true, 0, 2, 2, Defs::DataFieldContent::PACKET, 4, 4, 4, 4)
            COP1(456, 3, 500, 2, 128, Defs::TimeoutType::ALERT, 128, 1000)

SECURITY_ASSOCIATION(1, Defs::AuthenticationAlgorithm::HMAC_SHA256_40_BIT, Defs::EncryptionAlgorithm::NO_ENCRYPTION)